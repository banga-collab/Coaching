# Copie ce fichier en .env.local et remplis avec les valeurs de ton projet Supabase
# (Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ta-cle-anon-publique

# Optionnel
# SUPABASE_SERVICE_ROLE_KEY=   (secrète : flux agenda + automatisations quotidiennes)
# ANTHROPIC_API_KEY=           (assistant IA)
# CRON_SECRET=                 (protège /api/cron)

# ---------- Paiement en ligne (secrets serveur : ne jamais préfixer par NEXT_PUBLIC_) ----------
# URL publique de l'app (retours Stripe/CMI). Sinon déduite des en-têtes de la requête.
# NEXT_PUBLIC_APP_URL=https://coach.moovup.ma
# Le prestataire actif se choisit dans Paramètres > Paiement en ligne (stripe | cmi | aucun).
# Les webhooks/callbacks n'ont pas de session : SUPABASE_SERVICE_ROLE_KEY est requise pour marquer les factures payées.
# Stripe (Dashboard > Développeurs > Clés API / Webhooks ; endpoint https://<domaine>/api/stripe/webhook,
# événement checkout.session.completed)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# CMI 3D Pay Hosting (fournis par le CMI ; callback https://<domaine>/api/cmi/callback)
# CMI_CLIENT_ID=
# CMI_STORE_KEY=
# CMI_GATEWAY_URL=https://testpayment.cmi.co.ma/fim/est3Dgate   (production : URL fournie par le CMI)

# ---------- WhatsApp Business Cloud API (Meta) ----------
# Jeton permanent d'un utilisateur système + Phone number ID (WhatsApp > Configuration de l'API).
# Activer ensuite l'envoi dans Paramètres > WhatsApp. Sans ces variables, les messages sont simulés.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# Hors fenêtre de 24 h, Meta exige des modèles approuvés : nom du modèle (variables {{1}}, {{2}}… dans l'ordre).
# WHATSAPP_TEMPLATE_LANG=fr
# WHATSAPP_TEMPLATE_SESSION_REMINDER=      ({{1}} prénom, {{2}} quand)
# WHATSAPP_TEMPLATE_INVOICE_OVERDUE=       ({{1}} prénom, {{2}} n° facture, {{3}} montant)
# WHATSAPP_TEMPLATE_CHECKIN_MISSING=       ({{1}} prénom)
# WHATSAPP_TEMPLATE_MEMBERSHIP_EXPIRING=   ({{1}} prénom, {{2}} abonnement, {{3}} date de fin)
# WHATSAPP_TEMPLATE_WELCOME=               ({{1}} prénom)
